<sdf version="1.8">
  <world name="default">

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
    </plugin>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat">
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.417553191144084</latitude_deg>
      <longitude_deg>54.50150845600432</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>10 10 30 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="my_map">
      <pose>0 0 0 1.57079632679 0 0</pose>
      <static>true</static>
      <link name="body">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>my_map.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>my_map.obj</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="gen0_model">
      <self_collide>true</self_collide>
      <pose>-20.6991 -22.4324 2.85 0 0 -0.5406</pose>
      <include merge="true">
        <uri>../urdf/gen0_model.sdf</uri>
      </include>
    </model>

    <model name="car_008">
      <self_collide>true</self_collide>
      <pose>8.0 0 3 0 0 1.57</pose>
      <include merge="true">
        <uri>../models/car_012/model.sdf</uri>
      </include>
    </model>

  </world>
</sdf>