    <unit name="meter" meter="1" />
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="leaf_02_material-effect">
      <profile_COMMON>
        <newparam sid="albedo_png-surface">
          <surface type="2D">
            <init_from>albedo_png</init_from>
          </surface>
        </newparam>
        <newparam sid="albedo_png-sampler">
          <sampler2D>
            <source>albedo_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="albedo_png-sampler" texcoord="UVMap" />
            </diffuse>
            <transparent opaque="A_ONE"><texture texture="albedo_png-sampler" texcoord="UVMap" /></transparent><transparency><float>1</float></transparency><index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="albedo_png" name="albedo_png">
      <init_from>albedo.png</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="leaf_02_material-material" name="leaf_02_material">
      <instance_effect url="#leaf_02_material-effect" />
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="leaf_02_mesh-mesh" name="leaf_02_mesh">
      <mesh>
        <source id="leaf_02_mesh-mesh-positions">
          <float_array id="leaf_02_mesh-mesh-positions-array" count="12">-0.02075195 -0.04931646 0 0.02075195 -0.04931646 0 0.02075195 0.04931646 0 -0.02075195 0.04931646 0</float_array>
          <technique_common>
            <accessor source="#leaf_02_mesh-mesh-positions-array" count="4" stride="3">
              <param name="X" type="float" />
              <param name="Y" type="float" />
              <param name="Z" type="float" />
            </accessor>
          </technique_common>
        </source>
        <source id="leaf_02_mesh-mesh-normals">
          <float_array id="leaf_02_mesh-mesh-normals-array" count="3">0 0 1</float_array>
          <technique_common>
            <accessor source="#leaf_02_mesh-mesh-normals-array" count="1" stride="3">
              <param name="X" type="float" />
              <param name="Y" type="float" />
              <param name="Z" type="float" />
            </accessor>
          </technique_common>
        </source>
        <source id="leaf_02_mesh-mesh-map-0">
          <float_array id="leaf_02_mesh-mesh-map-0-array" count="12">1 0 0 1 0 0 1 0 1 1 0 1</float_array>
          <technique_common>
            <accessor source="#leaf_02_mesh-mesh-map-0-array" count="6" stride="2">
              <param name="S" type="float" />
              <param name="T" type="float" />
            </accessor>
          </technique_common>
        </source>
        <vertices id="leaf_02_mesh-mesh-vertices">
          <input semantic="POSITION" source="#leaf_02_mesh-mesh-positions" />
        </vertices>
        <triangles material="leaf_02_material-material" count="2">
          <input semantic="VERTEX" source="#leaf_02_mesh-mesh-vertices" offset="0" />
          <input semantic="NORMAL" source="#leaf_02_mesh-mesh-normals" offset="1" />
          <input semantic="TEXCOORD" source="#leaf_02_mesh-mesh-map-0" offset="2" set="0" />
          <p>1 0 0 3 0 1 0 0 2 1 0 3 2 0 4 3 0 5</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="leaf_02" name="leaf_02" type="NODE">
